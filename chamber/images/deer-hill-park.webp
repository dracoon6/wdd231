<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 200" width="300" height="200">
  <defs>
    <linearGradient id="parkGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#90EE90;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#228B22;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="300" height="200" fill="url(#parkGrad)"/>
  <rect x="30" y="100" width="60" height="80" fill="#C0C0C0" stroke="#333" stroke-width="2"/>
  <polygon points="60,100 45,70 75,70" fill="#FF6347"/>
  <rect x="130" y="90" width="120" height="90" fill="#FFB6C1" stroke="#FF1493" stroke-width="2"/>
  <line x1="150" y1="90" x2="150" y2="180" stroke="#333" stroke-width="2"/>
  <line x1="170" y1="90" x2="170" y2="180" stroke="#333" stroke-width="2"/>
  <line x1="210" y1="90" x2="210" y2="180" stroke="#333" stroke-width="2"/>
  <polygon points="190,90 180,50 200,50" fill="#FFD700"/>
  <circle cx="80" cy="80" r="12" fill="#FF69B4" opacity="0.7"/>
  <circle cx="100" cy="85" r="14" fill="#FFB6C1" opacity="0.7"/>
  <text x="150" y="30" font-size="20" text-anchor="middle" fill="white" font-weight="bold">Deer Hill Park</text>
</svg>
